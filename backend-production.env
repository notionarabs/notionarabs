# ===========================================
# NOTION ARABS BACKEND - PRODUCTION ENV FILE
# ===========================================
# Copy this to your EC2 instance as .env file

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGODB_URI=mongodb://localhost:27017/notion-arabs

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=production

# Backend URL (YOUR ACTUAL EC2 URL)
BACKEND_URL=https://50.19.23.245

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# Your Vercel frontend URL (REPLACE WITH YOUR ACTUAL VERCEL URL)
FRONTEND_URL=https://your-vercel-app.vercel.app

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=notion-arabs-super-secret-jwt-key-2024-production-very-long-and-random-123456789
JWT_EXPIRE=7d

# ===========================================
# GOOGLE OAUTH CONFIGURATION
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Google OAuth callback URL (YOUR ACTUAL EC2 URL + callback path)
GOOGLE_CALLBACK_URL=https://50.19.23.245/api/auth/google/callback

# ===========================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

# ===========================================
# CLOUDINARY CONFIGURATION
# ===========================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===========================================
# BREVO EMAIL SERVICE (Alternative to Gmail)
# ===========================================
BREVO_API_KEY=your-brevo-api-key-here

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FEATURE FLAGS
# ===========================================
REGISTRATION_ENABLED=true
CREATOR_APPLICATIONS_ENABLED=true
MAINTENANCE_MODE=false

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
REQUEST_LOGGING=true
